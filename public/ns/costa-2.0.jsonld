{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://gocosta.org/ns/2.0#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "costaId": "@id",
    "lotId": "@id",
    "reportId": "@id",
    "name": { "@id": "schema:name", "@container": "@language" },
    "brand": { "@id": "schema:brand" },
    "url": { "@id": "schema:url", "@type": "@id" },
    "sku": { "@id": "schema:sku" },
    "gtin": { "@id": "schema:gtin14" },
    "ingredients": { "@container": "@language" },
    "flavour": { "@container": "@language" },
    "storageConditions": { "@container": "@language" },
    "short": { "@container": "@language" },
    "long": { "@container": "@language" },
    "product": { "@type": "@id" },
    "supersedes": { "@type": "@id" },
    "supersededBy": { "@type": "@id" },
    "jwksUrl": { "@type": "@id" },
    "nextPage": { "@type": "@id" },
    "scopeUrl": { "@type": "@id" },
    "noticeUrl": { "@type": "@id" },
    "validFrom": { "@type": "xsd:date" },
    "validThrough": { "@type": "xsd:date" },
    "packagingDate": { "@type": "xsd:date" },
    "expiryDate": { "@type": "xsd:date" },
    "issuedDate": { "@type": "xsd:date" },
    "recordUpdated": { "@type": "xsd:dateTime" },
    "generated": { "@type": "xsd:dateTime" },
    "conformsTo": { "@container": "@set" },
    "extensions": { "@id": "extensions", "@type": "@json" }
  }
}